      </Compile>
      <Compile Update="Controls\FirstColumn\ConfiguringCloudCompressionRatio.cs">
        <SubType>Component</SubType>
      </Compile>
      <Compile Update="Controls\FirstColumn\SettingUpLayoutAlgorithm.cs">
        <SubType>Component</SubType>
      </Compile>
      <Compile Update="Controls\FirstColumn\ImageSizeSettings.cs">
